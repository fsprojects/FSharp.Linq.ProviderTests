root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{fsproj,props,targets,slnx,yml,yaml,json,config}]
indent_size = 2

[*.{ps1,fsx}]
end_of_line = lf

[*.tsv]
# Baselines: tab-separated, one line per scenario
indent_style = tab
trim_trailing_whitespace = false
